* text=auto eol=lf
# Preserve the exact vendor bytes checked by scripts/check.mjs.
site/vendor/*.js -text
# MVT protobuf bytes must not undergo line-ending conversion.
*.pbf binary
# Preserve the CSV bytes referenced by the public population manifest.
site/data/zone-population/*.csv -text whitespace=cr-at-eol
# Preserve the reviewed map snapshot and its source manifest hashes.
site/data/reported-locations/locations.geojson -text whitespace=cr-at-eol
site/data/reported-locations/location-register.csv -text whitespace=cr-at-eol
site/vendor/leaflet-1.9.4/*.js -text
site/vendor/leaflet-1.9.4/*.css -text whitespace=cr-at-eol
site/reports/*.pdf binary
