{
  "name": "fresno-storm-watch-prototype",
  "version": "0.73.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "check:briefing-layers": "node --use-system-ca scripts/check-briefing-layers.mjs",
    "check:roads": "node --use-system-ca scripts/check-roads.mjs",
    "collect:reservoirs": "node --use-system-ca scripts/collect-reservoirs.mjs",
    "watch:reservoirs": "node --use-system-ca scripts/collect-reservoirs.mjs --watch",
    "collect:power-network": "node --use-system-ca scripts/collect-power-network.mjs",
    "collect:power": "node --use-system-ca scripts/collect-power.mjs",
    "collect:comparisons": "node --use-system-ca scripts/collect-comparisons.mjs",
    "collect:wind": "node --use-system-ca scripts/collect-wind.mjs",
    "collect:briefing": "node --use-system-ca scripts/collect-briefing.mjs",
    "collect:probability": "node --use-system-ca scripts/collect-probability.mjs",
    "build:waterway-basemap": "node scripts/build-waterway-basemap.mjs",
    "build:waterbody-basemap": "node scripts/build-waterbody-basemap.mjs",
    "collect:map-pilot": "node --use-system-ca scripts/collect-map-pilot.mjs",
    "collect:sandbags": "node --use-system-ca scripts/collect-sandbags.mjs",
    "collect:pio-languages": "node --use-system-ca scripts/collect-pio-languages.mjs",
    "collect:zone-population": "node --use-system-ca scripts/acquire-zone-population.mjs",
    "build:zone-population": "node --use-system-ca scripts/build-zone-population.mjs",
    "build:import-map": "node scripts/import-map.mjs"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "2.0.4",
    "@terraformer/arcgis": "2.2.2",
    "geographiclib-geodesic": "2.2.0",
    "geojson-vt": "4.0.2",
    "maplibre-gl": "6.15.0",
    "pbf": "4.0.1",
    "polygon-clipping": "0.15.7",
    "vt-pbf": "3.1.3"
  }
