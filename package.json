{
  "name": "fresno-storm-watch-prototype",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "check:roads": "node --use-system-ca scripts/check-roads.mjs",
    "collect:reservoirs": "node --use-system-ca scripts/collect-reservoirs.mjs",
    "watch:reservoirs": "node --use-system-ca scripts/collect-reservoirs.mjs --watch",
    "collect:power": "node --use-system-ca scripts/collect-power.mjs"
  }
}
